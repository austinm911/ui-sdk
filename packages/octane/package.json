{
  "name": "@ui-sdk/octane",
  "version": "0.1.0-beta.13",
  "description": "UI SDK for Octane.",
  "keywords": [
    "react",
    "ui",
    "ui-sdk",
    "shadcn",
    "behaviors",
    "accessibility",
    "a11y",
    "aria",
    "keyboard",
    "focus",
    "headless",
    "unstyled",
    "components",
    "agents"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://ui-sdk.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/ui.git",
    "directory": "packages/octane"
  },
  "bugs": "https://github.com/vercel-labs/ui/issues",
  "exports": {
    "./field": "./src/field.tsrx",
    "./menu": "./src/menu.tsrx",
    "./primitive": "./src/primitive.ts",
    "./select": "./src/select.tsrx",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "exports": {
      "./field": {
        "types": "./dist/field.d.ts",
        "default": "./dist/field.js"
      },
      "./menu": {
        "types": "./dist/menu.d.ts",
        "default": "./dist/menu.js"
      },
      "./primitive": {
        "types": "./dist/primitive.d.ts",
        "default": "./dist/primitive.js"
      },
      "./select": {
        "types": "./dist/select.d.ts",
        "default": "./dist/select.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "node ../../scripts/tsgo.mjs --noEmit"
  },
  "peerDependencies": {
    "@ui-sdk/core": "workspace:^",
    "octane": ">=0.18.0"
  },
  "devDependencies": {
    "@ui-sdk/core": "workspace:*",
    "octane": "0.18.0"
  }
}
