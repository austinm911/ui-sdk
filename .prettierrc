{
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "plugins": [
    "@tsrx/prettier-plugin",
    "prettier-plugin-svelte"
  ],
  "overrides": [
    {
      "files": [
        "*.tsrx"
      ],
      "options": {
        "parser": "tsrx"
      }
    }
  ]
}
