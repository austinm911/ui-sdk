{
  "name": "playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port ${PLAYGROUND_PORT:-5300} --strictPort",
    "build": "NODE_ENV=development vite build && NODE_ENV=development vite build --ssr src/ssr.ts --outDir dist-ssr && NODE_ENV=development vite build --ssr src/ssr/vue.ts --outDir dist-ssr --emptyOutDir false && NODE_ENV=development vite build --ssr src/ssr/solid.ts --outDir dist-ssr --emptyOutDir false",
    "preview": "vite preview --port ${PLAYGROUND_PORT:-5300} --strictPort",
    "typecheck": "vue-tsc --noEmit && svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings && node ../../scripts/tsgo.mjs --noEmit -p tsconfig.solid.json && tsrx-tsc --noEmit -p tsconfig.octane.json"
  },
  "dependencies": {
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@solidjs/web": "catalog:",
    "@ui-sdk/core": "workspace:*",
    "@ui-sdk/octane": "workspace:*",
    "@ui-sdk/react": "workspace:*",
    "@ui-sdk/solid": "workspace:*",
    "@ui-sdk/svelte": "workspace:*",
    "@ui-sdk/vue": "workspace:*",
    "@ui-sdk/web": "workspace:*",
    "@vue/server-renderer": "^3.5.43",
    "octane": "0.18.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "svelte": "catalog:",
    "tests": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@tsrx/oxc": "0.24.0",
    "@tsrx/typescript-plugin": "0.6.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  }
}
